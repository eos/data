# Overview

This report was generated with EOS v{{ eos.version }} from the analysis file
`{{ analysis_file.analysis_file if analysis_file.analysis_file else 'analysis.yaml' }}`.
It documents the determination of the `SSE` form-factor coefficients for
{{ analysis | length }} posterior{{ 's' if analysis | length != 1 }}, grouped by
transition type. For each posterior it lists the local $p$ values of the individual
constraints (and the global $p$ value where the fit is over-constrained), together
with the posterior-predicted form factors overlaid on the input constraints.

{# Classify every posterior by the structure of its varied SSE coefficients:
   baryonic 1/2^+->1/2^+ coefficients are written alpha^(pol,current)_n (parenthesis),
   the P->P coefficients are alpha^f{+,0,T}_n, and everything else is P->V. #}
{% set groups = namespace(pp=[], pv=[], hh=[]) %}
{% for posterior in analysis %}
{% set joined = posterior.samples.varied_parameters | map(attribute='name') | join(' ') if posterior.samples else '' %}
{% if 'alpha^(' in joined %}
{% set _ = groups.hh.append(posterior) %}
{% elif 'alpha^f' in joined %}
{% set _ = groups.pp.append(posterior) %}
{% else %}
{% set _ = groups.pv.append(posterior) %}
{% endif %}
{% endfor %}

{% set ordered = [
  ('Pseudoscalar to pseudoscalar ($P \\to P$)', groups.pp),
  ('Pseudoscalar to vector ($P \\to V$)',       groups.pv),
  ('Spin-1/2 to spin-1/2 ($1/2^+ \\to 1/2^+$)', groups.hh)
] %}
{% for group_title, posteriors in ordered %}
{% if posteriors %}
# {{ group_title }}

{% for posterior in posteriors %}
## Posterior `{{ posterior.name }}`

{% set joined = posterior.samples.varied_parameters | map(attribute='name') | join(' ') if posterior.samples else '' %}
{% set is_baryon = 'alpha^(' in joined %}
{% set is_pp = (not is_baryon) and ('alpha^f' in joined) %}
{#- Collect the constraints of the identically-named likelihood and detect a PDG rescale. -#}
{% set resc = namespace(factor=none) %}
{% set constraints = [] %}
{% if posterior.name in analysis_file._likelihoods %}
{% for c in analysis_file._likelihoods[posterior.name].constraints %}
{% set _ = constraints.append(c.constraint) %}
{% if ';rescale-factor=' in c.constraint %}
{% set resc.factor = c.constraint.split(';rescale-factor=')[1] %}
{% endif %}
{% endfor %}
{% for c in analysis_file._likelihoods[posterior.name].manual_constraints %}
{% set _ = constraints.append(c.name) %}
{% endfor %}
{% endif %}
{#- Whether the tensor form factors are constrained/varied for this transition. -#}
{% set no_tensor = (is_pp and 'alpha^fT' not in joined) or (is_baryon and ',T)' not in joined and ',T5)' not in joined) %}

